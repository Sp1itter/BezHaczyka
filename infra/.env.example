# =============================================================================
# InvestWatch - konfiguracja calego stosu (przyklad). Skopiuj do infra/.env:
#   cp .env.example .env && docker compose up -d --build
# Tylko wartosci przykladowe i deweloperskie - zadnych prawdziwych sekretow.
# DATABASE_URL sklada compose z POSTGRES_* (nie ustawiaj go tutaj).
# =============================================================================

# --- Postgres ---
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=zmien-mnie-lokalnie
POSTGRES_DB=investwatch

# --- porty wystawione na localhost ---
POSTGRES_PORT=5432
VALKEY_PORT=6379
S3_PORT=8333
DEMO_CORPUS_PORT=8080
API_PORT=8000
WEB_PORT=7090
DASHBOARD_PORT=7080
# 0.0.0.0 = panel widoczny w sieci lokalnej (LAN)
DASHBOARD_BIND=127.0.0.1
# http://api:8000 = baza (domyslnie), http://dashboard-mock:4000 = mock (profil mock)
DASHBOARD_API_UPSTREAM=http://api:8000

# --- kolejka (Valkey) ---
VALKEY_URL=redis://valkey:6379/0

# --- magazyn obiektow SeaweedFS (S3): klucze tworzy kontener z tych wartosci ---
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=investwatch-dev-key
S3_SECRET_KEY=investwatch-dev-secret-zmien-mnie

# --- analyzer (nazwy jak w services/analyzer/.env.example) ---
PROFILE=gpu8
# Domyslnie Ollama NATYWNIE na hoscie. Przy profilu compose `ollama` ustaw
# OLLAMA_BASE_URL=http://ollama:11434 i pobierz modele:
#   docker compose exec ollama ollama pull <model>
# Bez Ollamy reguly LLM daja not_applicable.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
OLLAMA_EMBED_MODEL=bge-m3
# Temperatura 0 + staly seed = powtarzalne werdykty (llm.py); zmiana psuje powtarzalnosc.
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
OLLAMA_TIMEOUT_S=120
WHISPER_MODEL=small
API_BASE_URL=http://api:8000
API_TIMEOUT_S=30

# --- scraper: liczba replik workerow ---
# SCRAPER_WORKERS: render (q:render, scraper-worker-render); SCRAPER_INGEST_WORKERS: discover (q:ingest).
SCRAPER_WORKERS=2
SCRAPER_INGEST_WORKERS=1
# Rotacja User-Agent / proxy dla wszystkich zrodel; separator `||`. Puste = domyslne UA, ruch bezposredni.
SCRAPER_USER_AGENTS=
SCRAPER_PROXIES=

# --- scraper: Facebook (Meta Ad Library) ---
# auto = na zywo, a przy bledzie/blokadzie przechodzi na korpus offline (fixtures/demo-ads/facebook);
# replay = tylko korpus offline
FB_MODE=auto
FB_COUNTRY=PL
FB_MAX_ADS_PER_RUN=25
FB_MAX_SCROLLS=3
FB_MIN_INTERVAL_S=5
FB_BREAKER_THRESHOLD=2
FB_BREAKER_COOLDOWN_S=1800

# --- scraper: YouTube ---
# Minimalny odstep miedzy zapytaniami do YouTube (globalnie, Valkey `yt:ratelimit`)
YT_MIN_INTERVAL_S=8

# --- scraper: przekazanie do analizy (nazwa funkcji RQ, bez importu miedzy serwisami) ---
SCRAPER_OUTPUT_QUEUE=q:gpu
SCRAPER_OUTPUT_FUNC=analyzer.worker.analyze_document

# --- harmonogram (services/scraper/schedule.yaml) ---
# Wylaczenie zadan po nazwach, np. SCHEDULE_DISABLE=fb-inwestycje,yt-finfluencerzy
SCHEDULE_DISABLE=
# Nadpisanie interwalu zadania w minutach: SCHEDULE_INTERVAL_<NAZWA> (np. SCHEDULE_INTERVAL_WWW_DEMO=5)
# SCHEDULE_FILE=/inny/plik.yaml
SCHEDULE_POLL_S=10
# Tylko dla uproszczonego launchera FB (python scheduler_main.py; compose go nie uzywa):
FB_QUERIES=inwestycje;zarabiaj na gieldzie
FB_REFRESH_MIN=30
