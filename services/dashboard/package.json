    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "vite": "5.4.11"
  }
}
