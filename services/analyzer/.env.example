# =============================================================================
# Serwis analyzer - przyklad konfiguracji srodowiska
#
# Skopiuj ten plik do .env i dostosuj. Plik .env jest w .gitignore i NIE
# trafia do repozytorium. Ten plik zawiera WYLACZNIE wartosci przykladowe
# i domyslne - nigdy nie wpisuj tu prawdziwych sekretow.
#
# PROFIL SPRZETOWY (zmienna PROFILE):
#   cpu    - wszystko na CPU (wolne, ale dziala wszedzie; plan B na demo)
#   gpu8   - Bielik 4.5B Q8_0 na GPU, Whisper medium int8 na CPU, bge-m3 na GPU
#            (profil domyslny; wymaga ~8 GB VRAM)
#   gpu16  - Bielik 11B v2.3 Q4_K_M na GPU, Whisper large-v3 na GPU
#            (wymaga >= 16 GB VRAM)
#
# Na maszynie deweloperskiej (RTX 3070 Ti Laptop, 8 GB VRAM) wlasciwy jest
# profil gpu8. Wartosci ponizej odpowiadaja wlasnie temu profilowi.
#
# UWAGA o adresach: domyslne wartosci w kodzie wskazuja na 127.0.0.1 (uruchomienie
# bez kontenera). W docker-compose serwisy osiagalne sa po nazwie (ollama, api,
# valkey), wiec tam nadpisujemy adresy na nazwy serwisow - patrz komentarze.
# =============================================================================

# --- profil sprzetowy -------------------------------------------------------
# Wybor profilu: cpu | gpu8 | gpu16. Na maszynie deweloperskiej: gpu8.
# Domyslnie gpu8 (health.py - raportowany w /health). Dobor modeli wynika z pozostalych zmiennych.
PROFILE=gpu8

# --- Ollama (Bielik - reguly semantyczne, bge-m3 - embeddingi) ---------------
# Adres API Ollamy. Domyslnie (kod): http://127.0.0.1:11434 - dla uruchomienia
# lokalnego bez kontenera. W docker-compose ustaw: http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model generatywny do regul semantycznych (Bielik 4.5B, kwantyzacja Q8_0).
# Domyslna wartosc z kodu (llm.py). Pasuje do profilu gpu8 i cpu.
# Dla profilu gpu16 zmien na wariant 11B v2.3 Q4_K_M (dobierz nazwe z `ollama list`).
OLLAMA_MODEL=SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0

# Model embeddingow (wektory 1024-wymiarowe) do deduplikacji i podobienstwa.
# Domyslna wartosc z kodu (llm.py).
OLLAMA_EMBED_MODEL=bge-m3

# Temperatura generowania. 0 (dekodowanie zachlanne) + staly seed = powtarzalne
# werdykty. Przy 0.1 ta sama reklama raz lamala reguly 1, 2 i 18, raz tylko 1 i 2
# (patrz llm.py i docs/STAN-PROJEKTU.md par. 4). Domyslnie 0 i seed 42.
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42

# Timeout pojedynczego zapytania do Ollamy w sekundach.
# Domyslnie 120 (llm.py). Generowanie JSON na CPU bywa wolne - nie skracaj bez testu.
OLLAMA_TIMEOUT_S=120

# --- speech-to-text (faster-whisper) -----------------------------------------
# Rozmiar modelu Whisper. Wartosc z tabeli profili w specyfikacji (par. 9.1):
#   cpu -> small, gpu8 -> medium (na CPU, int8), gpu16 -> large-v3 (GPU).
# Domyslnie small (stt.py): zmierzone 4,7 s na 18 s polskiego audio, CPU int8.
WHISPER_MODEL=small
# 0 wylacza transkrypcje (maszyna bez faster-whisper). Domyslnie 1.
STT_ENABLED=1
# Katalog z plikami wideo korpusu (dopasowanie po ad_archive_id).
STT_MEDIA_ROOT=fixtures/demo-ads/facebook
# Cache pobranych mediow (http/s3) i limit rozmiaru jednego pliku.
# STT_MEDIA_CACHE=
STT_MAX_MEDIA_MB=200
# Publiczny adres bramy S3 SeaweedFS - zamienia uri s3://bucket/key na GET.
# Puste = media z s3:// sa pomijane (reguly osi czasu -> not_applicable).
SEAWEEDFS_S3_PUBLIC_URL=

# --- casedb (wspolna baza przypadkow) -----------------------------------------
# Uzywane przez tools/casedb_batch.py --db. Na Windows 127.0.0.1, nie localhost.
DATABASE_URL=postgresql://investwatch:CHANGE_ME@127.0.0.1:5432/investwatch
# Zapis kazdego Findingu do pliku JSON (demo bez serwisu api). Puste = wylaczone.
FINDINGS_OUT_DIR=

# --- API i kolejka ------------------------------------------------------------
# Bazowy adres serwisu api, z ktorego analyzer pobiera zadania / do ktorego wysyla wyniki.
# Domyslna wartosc z kodu (api_client.py): http://api:8000 (nazwa serwisu `api` w docker-compose).
API_BASE_URL=http://api:8000

# Timeout pojedynczego wywolania HTTP do serwisu api, w sekundach.
# Domyslnie 30 (api_client.py).
API_TIMEOUT_S=30

# Adres kolejki/cache (Valkey, protokol Redis). Nazwa serwisu `valkey` z docker-compose,
# standardowy port 6379, baza 0.
# Dla uruchomienia lokalnego bez kontenera: redis://127.0.0.1:6379/0
VALKEY_URL=redis://valkey:6379/0

# --- magazyn danych -------------------------------------------------------------
# Skad worker bierze dokumenty i dokad zapisuje Findingi: db | api.
# Domyslnie db, gdy ustawione DATABASE_URL, inaczej api (ApiClient + API_BASE_URL).
ANALYZER_STORE=db

# Polaczenie z Postgresem (pakiet casedb): ta sama zmienna DATABASE_URL co w sekcji casedb
# powyzej. W docker-compose: postgresql://investwatch:<haslo>@postgres:5432/investwatch
